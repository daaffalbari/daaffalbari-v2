# Required — powers the "Ask my agent" chatbot (src/app/api/chat/route.ts).
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Optional — OpenRouter model slug used by the chatbot.
# Defaults to openai/gpt-4o-mini if unset.
MODEL_NAME=openai/gpt-4o-mini

# Optional — enables Keystatic's GitHub storage mode so /keystatic can commit
# to this repo from the live site. Unset = local mode (dev-only editing, no
# auth needed). See docs/CMS_SETUP.md for how to create the GitHub App.
KEYSTATIC_GITHUB_CLIENT_ID=
KEYSTATIC_GITHUB_CLIENT_SECRET=
KEYSTATIC_SECRET=
NEXT_PUBLIC_KEYSTATIC_GITHUB_APP_SLUG=

# Optional — HTTP Basic Auth password gating /keystatic and /api/keystatic
# in production (see src/middleware.ts). Unset = no gate (fine for local
# dev; set this on Vercel before your first production deploy).
KEYSTATIC_ADMIN_PASSWORD=
